# ===== Discord =====
# Token bot Discord (BẮT BUỘC)
DISCORD_TOKEN=

# ID kênh Discord dùng để điều khiển (BẮT BUỘC)
DISCORD_CHANNEL_ID=

# (tuỳ chọn) Danh sách user ID được phép, cách nhau bởi dấu phẩy. Để trống = ai trong kênh cũng dùng được.
ALLOWED_USER_IDS=

# ===== OpenCode server =====
# Mặc định (để trống OPENCODE_URL): bridge TỰ DÒ server "background service" mà TUI/desktop
# đang dùng (đọc ~/.local/state/opencode/service.json) và KẾT NỐI vào đó -> DÙNG CHUNG phiên,
# không cần mở TUI bằng --server thủ công. Nếu không có server nào thì bridge tự spawn server riêng.
OPENCODE_URL=

# Thông tin xác thực (chỉ cần khi đặt OPENCODE_URL, hoặc muốn cố định mật khẩu server tự spawn)
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# Cổng cho server tự spawn (khi không tìm thấy server dùng chung)
OPENCODE_PORT=4097

# Tự dò server dùng chung (mặc định BẬT). Đặt 0 để luôn tự spawn server riêng.
OPENCODE_AUTO_SERVICE=

# Đường dẫn file thông tin service (thường không cần đổi)
OPENCODE_SERVICE_FILE=

# Thư mục project mà agent sẽ làm việc (mặc định: thư mục hiện tại)
PROJECT_DIR=

# Đường dẫn binary opencode (mặc định: opencode trên PATH)
OPENCODE_BIN=opencode

# Thư mục làm việc mặc định cho phiên mới do bridge tạo.
# Trống = dùng thư mục hiện tại (PROJECT_DIR). Có thể đổi lúc chạy bằng lệnh !cd.
OPENCODE_DIR=

# (Nâng cao) Chỉ dùng khi bridge tự spawn server riêng VÀ bạn đã tự trỏ TUI vào nó bằng
# `opencode --server http://127.0.0.1:<OPENCODE_PORT>`. Đặt 1 để tắt cảnh báo "server riêng".
OPENCODE_SHARED=

# ===== Hành vi =====
# Agent mặc định (mặc định: build)
OPENCODE_AGENT=build

# Nơi đổ output của agent:
#   thread  = output vào thread riêng; lệnh (!help/!queue...) nằm ở kênh chính (mặc định)
#   channel = quay lại hành vi cũ (output ngay trong kênh chính)
OUTPUT_MODE=thread

# ===== Mirror phiên ngoài (tuỳ chọn) =====
# Khi bật bằng lệnh "!sync on", bridge sẽ phản chiếu các phiên opencode KHÁC
# (bạn mở từ TUI/CLI) vào thread riêng trên Discord, dạng rút gọn (chỉ text).
# LƯU Ý: chỉ hoạt động khi bridge DÙNG CHUNG server với TUI (xem README mục "Mirror").
# Chỉ mirror phiên thuộc thư mục này (so khớp chuỗi con). Trống = mọi thư mục.
MIRROR_DIR=
# Số phiên ngoài tối đa được mirror (chống spam thread).
MIRROR_MAX=25
